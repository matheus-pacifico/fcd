__fcd_main() {
	local origin_dir="$PWD"
	local current_dir="$origin_dir"
	local out key sel status
	local nav_history=""
	local toggle_history=""

	local FZF_DEFAULT_OPTS=''
	local FZF_DEFAULT_OPTS_FILE=''
	local FZF_DEFAULT_COMMAND=''

	while true; do
		if [[ $_fcd_navigation_mode == "dir" ]]; then
			out=$(__fcd_launch_dir_fzf "$toggle_history" "$current_dir" "$nav_history")
		else
			out=$(__fcd_launch_drive_fzf "$toggle_history")
		fi
		status=$?
		[[ $status -ne 0 ]] && return $status

		key="${out%%$'\n'*}"; out="${out#*$'\n'}"
		sel="${out%%$'\n'*}"; out="${out#*$'\n'}"
 		toggle_history="${out#*$'\n'}"
		_fcd_show_hidden="${toggle_history%%,*}"

		[[ $key == "reload" ]] && continue
		[[ -z $sel ]] && return 1
		if [[ $key == "alt-q" ]]; then
			if [[ $_fcd_navigation_mode == "dir" ]]; then
				nav_history="${out%%$'\n'*}"
				current_dir="$sel"
				_fcd_navigation_mode="toggled_drive"
			else
				_fcd_navigation_mode="dir"
			fi
			continue
		fi
		if [[ $sel == "$origin_dir" ]]; then
			if [[ $_fcd_out_on_same == "dot" ]]; then
				builtin printf '%s%b' '.' "$_fcd_eol"
			elif [[ $_fcd_out_on_same == "current" ]]; then
				builtin printf '%s%b' "$sel" "$_fcd_eol"
			fi
			return 64
		fi
		builtin printf '%s%b' "$sel" "$_fcd_eol"
		break
	done

	return 0
}

__fcd_parse_options() {
	local source="$1"
	source="${source:+$source: }"
	shift

	while [[ $# -gt 0 ]]; do
		case "$1" in
			# output
			--print0) _fcd_eol='\0' ;;
			--print-current-dot) _fcd_out_on_same="dot" ;;
			--print-current) _fcd_out_on_same="current" ;;

			# navigation
			--walker|--walker=*)
					local walker_value
					if [[ $1 == *=* ]]; then
						walker_value="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}walker options required: dir|drive[,[no]follow][,[no]hidden]" >&2; return 2; }
						shift; walker_value="$1"
					fi
					[[ -z $walker_value ]] && { builtin printf '%s\n' "${source:-}at least 'dir' or 'drive' should be specified" >&2; return 2; }
					_fcd_navigation_mode=""
					IFS=',' read -r -a walker_opts <<< "$walker_value"
					for opt in "${walker_opts[@]}"; do
						case "$opt" in
							dir) _fcd_navigation_mode="dir" ;;
							drive) _fcd_navigation_mode="drive" ;;
							hidden) _fcd_show_hidden=1 ;;
              nohidden) _fcd_show_hidden=0 ;;
							follow) _fcd_follow_symlink=1 ;;
              nofollow) _fcd_follow_symlink=0 ;;
							'') ;;
							*) builtin printf '%s\n' "${source:-}invalid walker option: $opt" >&2; return 2 ;;
						esac
					done
					[[ -z $_fcd_navigation_mode ]] && { builtin printf '%s\n' "${source:-}at least 'dir' or 'drive' should be specified" >&2; return 2; }
					;;
			--walker-root|--walker-root=*)
					if [[ $1 == *=* ]]; then
						_fcd_root_dir="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}no directory specified" >&2; return 2; }
						shift; _fcd_root_dir="$1"
					fi
					;;
			--walker-skip|--walker-skip=*)
					if [[ $1 == *=* ]]; then
						_fcd_skip_dirs="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}directory names to ignore required" >&2; return 2; }
						shift; _fcd_skip_dirs="$1"
					fi
					;;
			--max-depth|--max-depth=*)
					if [[ $1 == *=* ]]; then
						_fcd_max_depth="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}maximum depth required: MAX_DEPTH" >&2; return 2; }
						shift; _fcd_max_depth="$1"
					fi
					[[ ! $_fcd_max_depth =~ ^[0-9]+$ || $_fcd_max_depth -eq 0 ]] && { builtin printf '%s\n' "${source:-}maximum depth must be a positive integer" >&2; return 2; }
					;;
			--no-max-depth) _fcd_max_depth="" ;;

			# sorting
			--sort)	_fcd_sort=1 ;;
			--no-sort) _fcd_sort=0 ;;
			--sort-order|--sort-order=*)
					if [[ $1 == *=* ]]; then
						_fcd_sort_order="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}sort order required (asc or desc)" >&2; return 2; }
						shift; _fcd_sort_order="$1"
					fi
					[[ ! "$_fcd_sort_order" =~ ^(asc|desc)$ ]] && { builtin printf '%s\n' "${source:-}invalid sort order (expected: asc or desc)" >&2; return 2; }
					;;

			# layout / ui
			--height|--height=*)
					if [[ $1 == *=* ]]; then
						_fcd_height="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}height required: [~][-]HEIGHT[%]" >&2; return 2; }
						shift; _fcd_height="$1"
					fi
					;;
			--min-height|--min-height=*)
					if [[ $1 == *=* ]]; then
						_fcd_min_height="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}minimum height required: HEIGHT[+]" >&2; return 2; }
						shift; _fcd_min_height="$1"
					fi
					;;
			--margin|--margin=*)
					if [[ $1 == *=* ]]; then
						_fcd_margin="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}margin required (TRBL / TB,RL / T,RL,B / T,R,B,L)" >&2; return 2; }
						shift; _fcd_margin="$1"
					fi
					;;
			--padding|--padding=*)
					if [[ $1 == *=* ]]; then
						_fcd_padding="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}padding required (TRBL / TB,RL / T,RL,B / T,R,B,L)" >&2; return 2; }
						shift; _fcd_padding="$1"
					fi
					;;
			--border|--border=*)
					if [[ $1 == *=* ]]; then
						_fcd_border="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}border style required" >&2; return 2; }
						shift; _fcd_border="$1"
					fi
					[[ $_fcd_border == "inline" ]] && { builtin printf '%s\n' "${source:-}inline border is not supported for --border" >&2; return 2; }
					;;
			--cycle) _fcd_cycle=1 ;;
			--no-cycle) _fcd_cycle=0 ;;
			--highlight-line) _fcd_highlight_line=1 ;;
			--no-highlight-line) _fcd_highlight_line=0 ;;
			--wrap|--wrap=*)
					if [[ $1 == *=* ]]; then
						_fcd_wrap="${1#*=}"
					else
						shift; _fcd_wrap="$1"
					fi
					[[ -z $_fcd_wrap ]] && { builtin printf '%s\n' "${source:-}wrap mode required (char or word)" >&2; return 2; }
					;;
			--no-wrap) _fcd_wrap="" ;;
			--no-mouse) _fcd_no_mouse=1 ;;
			--layout|--layout=*)
					if [[ $1 == *=* ]]; then
						_fcd_layout="${1#*=}"
					else
					[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}layout required (bottom / top / top-list)" >&2; return 2; }
						shift; _fcd_layout="$1"
					fi
					[[ ! "$_fcd_layout" =~ ^(bottom|top|top-list)$ ]] && { builtin printf '%s\n' "${source:-}invalid layout (expected: bottom / top / top-list)" >&2; return 2; }
					;;
			--ellipsis|--ellipsis=*)
					if [[ $1 == *=* ]]; then
						_fcd_ellipsis="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}ellipsis string required" >&2; return 2; }
						shift; _fcd_ellipsis="$1"
					fi
					;;
			--path-padding|--path-padding=*)
					if [[ $1 == *=* ]]; then
						_fcd_path_padding="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}path padding required: PADDING" >&2; return 2; }
						shift; _fcd_path_padding="$1"
					fi
					[[ ! "$_fcd_path_padding" =~ ^[0-9]+$ ]] && { builtin printf '%s\n' "${source:-}path padding must be a non-negative integer" >&2; return 2; }
					;;
			--path-truncate|--path-truncate=*)
					if [[ $1 == *=* ]]; then
						_fcd_path_truncate="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}path truncate required (start or end)" >&2; return 2; }
						shift; _fcd_path_truncate="$1"
					fi
					[[ ! "$_fcd_path_truncate" =~ ^(start|end)$ ]] && { builtin printf '%s\n' "${source:-}invalid path truncate (expected: start or end)" >&2; return 2; }
					;;
			--path-position|--path-position=*)
					local path_pos_value
					if [[ $1 == *=* ]]; then
						path_pos_value="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}path position required ([N][:top|bottom|header|none])" >&2; return 2; }
						shift; path_pos_value="$1"
					fi
					[[ -z $path_pos_value ]] && { builtin printf '%s\n' "${source:-}invalid path position (expected: [N][:top|bottom|header|none])" >&2; return 2; }
					_fcd_path_anchor=""
					_fcd_path_column=""
					IFS=':' read -r -a path_pos_opts <<< "$path_pos_value"
					for opt in "${path_pos_opts[@]}"; do
						case "$opt" in
							top|bottom|header|none) _fcd_path_anchor="$opt" ;;
							'') ;;
							*)
								if [[ $opt =~ ^[-+]?[0-9]+$ ]]; then
									_fcd_path_column="$opt"
								else
									builtin printf '%s\n' "${source:-}invalid path position option: $opt" >&2
									return 2
								fi
								;;
						esac
					done
					if [[ -z $_fcd_path_anchor && -z $_fcd_path_column ]]; then
						builtin printf '%s\n' "${source:-}invalid path position (expected: [N][:top|bottom|header|none])" >&2
						return 2
					fi
					;;
			--no-input) _fcd_no_input="disabled" ;;
			--info|--info=*)
					if [[ $1 == *=* ]]; then
						_fcd_info="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}info style required" >&2; return 2; }
						shift; _fcd_info="$1"
					fi
					;;
			--no-info) _fcd_info="hidden" ;;
			--separator|--separator=*)
					if [[ $1 == *=* ]]; then
						_fcd_separator="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}separator character required" >&2; return 2; }
						shift; _fcd_separator="$1"
					fi
					_fcd_define_separator=1
					;;
			--no-separator) _fcd_separator=""; _fcd_define_separator=1 ;;

			# preview
			--preview-window|--preview-window=*)
					if [[ $1 == *=* ]]; then
						_fcd_p_window="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}preview window layout required" >&2; return 2; }
						shift; _fcd_p_window="$1"
					fi
					;;
			--preview|--preview=*)
					local preview_value
					if [[ $1 == *=* ]]; then
						preview_value="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}preview options required [dir][,file][,[no]follow][,[no]sort][,[no]hidden|auto][,asc|desc][,list|tree|grid][,N]" >&2; return 2; }
						shift; preview_value="$1"
					fi
					[[ -z $preview_value ]] && { builtin printf '%s\n' "${source:-}at least one of 'dir' or 'file' should be specified" >&2; return 2; }
					_fcd_p_show_dirs=0
					_fcd_p_show_files=0
					IFS=',' read -r -a preview_opts <<< "$preview_value"
					for opt in "${preview_opts[@]}"; do
						case "$opt" in
              dir) _fcd_p_show_dirs=1 ;;
              file) _fcd_p_show_files=1 ;;
              hidden) _fcd_p_show_hidden=1 ;;
              nohidden) _fcd_p_show_hidden=0 ;;
              auto) _fcd_p_show_hidden="auto" ;;
              follow) _fcd_p_follow_symlink=1 ;;
              nofollow) _fcd_p_follow_symlink=0 ;;
              sort) _fcd_p_sort=1 ;;
              nosort) _fcd_p_sort=0 ;;
              asc|desc) _fcd_p_sort_order="$opt" ;;
              list|tree|grid) _fcd_p_mode="$opt" ;;
							'') ;;
							*) 
								if [[ $opt =~ ^[0-9]+$ ]]; then
									_fcd_p_max_depth="$opt"
								else
									builtin printf '%s\n' "${source:-}invalid preview option: $opt" >&2
									return 2
								fi
								;;
						esac
					done
					[[ $_fcd_p_show_dirs -eq 0 && $_fcd_p_show_files -eq 0 ]] && { builtin printf '%s\n' "${source:-}at least one of 'dir' or 'file' should be specified" >&2; return 2; }
					;;

			# tmux
			--tmux|--tmux=*)
					local tmux_opts_raw
					if [[ $1 == *=* ]]; then
						tmux_opts_raw="${1#*=}"
					else
						[[ $# -lt 2 ]] && { _fcd_use_tmux=1; shift; continue; }
						shift; tmux_opts_raw="$1"
					fi
					[[ -z "${tmux_opts_raw// /}" ]] && { builtin printf '%s\n' "${source:-}invalid tmux option" >&2; return 2; }
					shift
					_fcd_use_tmux=1
					# "--" can be used to separate fzf-tmux options from fcd options
          if [[ $tmux_opts_raw == "-- "* || $tmux_opts_raw == *" -- "* ]]; then
            if [[ $tmux_opts_raw == "-- "* ]]; then
              local fcd_args_raw="${tmux_opts_raw#-- }"
            else
							while IFS= read -r opt; do
								_fcd_tmux_opts+=("$opt")
							done < <(xargs printf '%s\n' <<< "${tmux_opts_raw%% -- *}")
							local fcd_args_raw="${tmux_opts_raw#* -- }"
            fi
						if [[ -n "${fcd_args_raw// /}" ]]; then
							local fcd_args=()
							while IFS= read -r arg; do
								fcd_args+=("$arg")
							done < <(xargs printf '%s\n' <<< "$fcd_args_raw")
							set -- "${fcd_args[@]}" "$@"
						fi
					elif [[ $tmux_opts_raw != "--" ]]; then
						while IFS= read -r opt; do
							_fcd_tmux_opts+=("$opt")
						done < <(xargs printf '%s\n' <<< "$tmux_opts_raw")
          fi
					continue
					;;

			# actions
			--version) __fcd_version; exit 0 ;;
			--help) __fcd_help; exit 0 ;;

			--ignore-ctrl-z) _fcd_ignore_ctrl_z=1 ;;

			--query|--query=*)
					if [[ $1 == *=* ]]; then
						_fcd_query="${1#*=}"
					else
						[[ $# -lt 2 ]] && { builtin printf '%s\n' "${source:-}query string required" >&2; return 2; }
						shift; _fcd_query="$1"
					fi
					;;

			--)	;;
			*)	builtin printf '%s\n' "${source:-}unknown option: $1" >&2; return 2 ;;
		esac
		shift
	done

	return 0
}

__fcd_format_drive_size() {
	local size="$1"

	local ONE_KiB=$((1 << 10))
	local ONE_MiB=$((1 << 20))
	local ONE_GiB=$((1 << 30))
	local ONE_TiB=$((1 << 40))
	local value unit

	if (( size >= ONE_TiB )); then
		value=$(( (size * 10) / ONE_TiB ))
		unit="T"
	elif (( size >= ONE_GiB )); then
		value=$(( (size * 10) / ONE_GiB ))
		unit="G"
	elif (( size >= ONE_MiB )); then
		value=$(( (size * 10) / ONE_MiB ))
		unit="M"
	else
		value=$(( (size * 10) / ONE_KiB ))
		unit="K"
	fi

	if (( value % 10 == 0 )); then
		builtin printf '%s' "$((value / 10))$unit"
	else
		builtin printf '%s' "$((value / 10)).$((value % 10))$unit"
	fi
}

__fcd_list_drives() {
	local drives=""
	local system_name=""
	local system_size=0

	local LABEL NAME SIZE MOUNTPOINT FSTYPE
	while IFS= read -r line; do
		[ -z "$line" ] && continue
		LABEL='' NAME='' SIZE='' MOUNTPOINT='' FSTYPE=''

		[[ $line =~ (^|[[:space:]])LABEL=\"([^\"]*)\" ]]      && LABEL="${BASH_REMATCH[2]}"
		[[ $line =~ (^|[[:space:]])NAME=\"([^\"]*)\" ]]       && NAME="${BASH_REMATCH[2]}"
		[[ $line =~ (^|[[:space:]])SIZE=\"([^\"]*)\" ]]       && SIZE="${BASH_REMATCH[2]}"
		[[ $line =~ (^|[[:space:]])MOUNTPOINT=\"([^\"]*)\" ]] && MOUNTPOINT="${BASH_REMATCH[2]}"
		[[ $line =~ (^|[[:space:]])FSTYPE=\"([^\"]*)\" ]]     && FSTYPE="${BASH_REMATCH[2]}"

		[ -z "$MOUNTPOINT" ] && continue
		case "$FSTYPE" in swap|crypt|LVM2_member) continue ;; esac

		case "$MOUNTPOINT" in
			"/"|"/home"|"/boot"|"/boot/efi"|"/var")
				[ "$MOUNTPOINT" = "/" ] && system_name="$NAME"
				system_size=$((system_size + SIZE))
				;;
			*)
				drives+="${LABEL:-Volume}"$'\t'"($NAME) $(__fcd_format_drive_size "$SIZE")"$'\t'"$MOUNTPOINT"$'\n'
				;;
		esac
	done < <(command lsblk -P -b -e 1,7,11,179 -o LABEL,NAME,SIZE,MOUNTPOINT,FSTYPE)
 
	if [ -n "$system_name" ]; then
		drives="System"$'\t'"($system_name) $(__fcd_format_drive_size "$system_size")"$'\t'"/"$'\n'"$drives"
	fi
	builtin printf '%s' "$drives"
}

__fcd_get_border_style() {
	local border_style

	if [[ -n $TMUX && $_fcd_use_tmux -eq 1 ]]; then
		if [[ ${#_fcd_tmux_opts[@]} -eq 0 ]]; then
			[[ -z $_fcd_path_anchor || $_fcd_path_anchor =~ ^(header|none)$ ]] && border_style="none" || border_style="top"
		else
			border_style="top"
		fi
	else
		border_style="top"
	fi

	builtin printf '%s' "$border_style"
}

__fcd_version() {
	builtin printf '%s\n' "fcd $_FCD_VERSION"
}

__fcd_help() {
	cat << 'EOF'
fcd is an interactive directory and drive navigator powered by fzf.

It provides an interactive interface for browsing directories fuzzy search, 
preview support, configurable navigation, and optional tmux integration.

Project URL: https://github.com/matheus-pacifico/fcd
Author: Matheus Pacifico

Usage: fcd [options]

  OUTPUT
    --print0                 Print output delimited by ASCII NUL characters
    --print-current          Print target directory even if it is the current directory
    --print-current-dot      Print '.' if target directory is the current directory

  NAVIGATION
    --walker=OPTS            dir|drive[,[no]follow][,[no]hidden]
                             (default: dir,follow,nohidden)
    --walker-root=DIR        Root directory to start navigation from (default: .)
    --walker-skip=DIRS       Comma-separated list of directory names to skip
                             (default: .git,node_modules)
    --max-depth=MAX_DEPTH    Maximum directory traversal depth (default: 1)
    --no-max-depth           Disable the maximum traversal depth

  SORTING
    --sort                   Enable sorting (default)
    --no-sort                Disable sorting
    --sort-order=ORDER       Sort order [asc|desc] (default: asc)

  LAYOUT/UI
    --height=[~][-]HEIGHT[%] Display fcd window below the cursor with the given
                             height instead of using fullscreen.
                             A negative value is calculated as the terminal height
                             minus the given value.
                             If prefixed with '~', fcd will determine the height
                             according to the input size.
    --min-height=HEIGHT[+]   Minimum height when --height is given as a percentage.
                             Add '+' to automatically increase the value
                             according to the other layout options (default: 10+).
    --layout=LAYOUT          Choose layout [bottom|top|top-list] (default: top)
    --margin=MARGIN          Screen margin (TRBL | TB,RL | T,RL,B | T,R,B,L)
    --padding=PADDING        Padding inside border (TRBL | TB,RL | T,RL,B | T,R,B,L)
    --border=STYLE           Draw border around finder
                             [rounded|sharp|bold|block|thinblock|double|dashed|horizontal|vertical|
                              top|bottom|left|right|line|none] (default: top)
    --cycle                  Enable cyclic scroll (default)
    --no-cycle               Disable cyclic scroll
    --highlight-line         Highlight the whole current line
    --no-highlight-line      Disable whole line highlighting (default)
    --wrap=MODE              Enable line wrap (char|word, default: word)
    --no-wrap                Disable line wrapping
    --ellipsis=STR           Ellipsis to show when line is truncated (default: '··')
    --no-mouse               Disable mouse interactions

  PATH DISPLAY
    --path-position=POS      Configure current path label position
                             [POSITIVE_INTEGER: columns from left|
                              NEGATIVE_INTEGER: columns from right][:top|bottom|header|none]
    --path-padding=N         Padding spaces around path string (default: 1)
    --path-truncate=MODE     Path truncation strategy [start|end] (default: start)

  INPUT SECTION
    --no-input               Disable and hide the input section
    --info=STYLE             Finder info style
                             [default|right|hidden|inline[-right][:PREFIX]]
    --no-info                Alias for --info=hidden
    --separator=STR          Draw horizontal separator on info line using the string
                             (default: '─' or '-')
    --no-separator           Hide info line separator

  PREVIEW WINDOW
    --preview=OPTS           Comma-separated preview settings:
                             [dir][,file][,[no]follow][,[no]sort][,[no]hidden|auto]
                             [,asc|desc][,list|tree|grid][,N]
                             N is max depth (set 0 for unlimited depth)
                             (default: dir,follow,sort,asc,list,nohidden,1)
    --preview-window=OPT     Preview window layout (default: nocycle:nohidden:40%:right)
                             [up|down|left|right|next][,SIZE[%]]
                             [,[no]wrap[-word]][,[no]cycle][,[no]follow][,[no]info]
                             [,[no]hidden][,border-STYLE]
                             [,+SCROLL[OFFSETS][/DENOM]][,~HEADER_LINES]
                             [,default][,<SIZE_THRESHOLD(ALTERNATIVE_LAYOUT)]

  INTEGRATION
    --tmux[=OPTS]            Run fcd through fzf-tmux
                             OPTS are passed directly to fzf-tmux.
                             Use '--' inside OPTS to separate fzf-tmux flags from fcd flags
    --ignore-ctrl-z          Disable the Ctrl-Z key binding

  SCRIPTING
    --query=STR              Start the finder with the given query

  HELP
    --help                   Show this help message
    --version                Display version information and exit

  ENVIRONMENT VARIABLES
    FCD_DEFAULT_OPTS         Default options (e.g. '--layout=bottom --no-sort')
    FCD_DEFAULT_OPTS_FILE    Location of the file to read default options from

EOF
}

__fcd_remove_comments() {
	sed '/^[[:space:]]*#/d'
}

__fcd_prepare_opts() {
  builtin printf '%s' "$1" | __fcd_remove_comments | xargs printf '%s\0'
}

__fcd_resolve_opts() {
	[[ $_fcd_p_max_depth -le 0 ]] && _fcd_p_max_depth=""
	[[ $_fcd_cycle -ne 1 ]] && _fcd_cycle=""
	[[ $_fcd_no_mouse -ne 1 ]] && _fcd_no_mouse=""
	[[ $_fcd_highlight_line -ne 1 ]] && _fcd_highlight_line=""
	[[ $_fcd_sort -eq 1 ]] && _fcd_sort="-h" || _fcd_sort=""
	[[ $_fcd_sort_order == "asc" ]] && _fcd_sort_order="" || _fcd_sort_order="-r"
	[[ $_fcd_p_sort_order == "asc" ]] && _fcd_p_sort_order="" || _fcd_p_sort_order="-r"
	[[ $_fcd_follow_symlink -eq 1 ]] && _fcd_follow_symlink="-L" || _fcd_follow_symlink=""
	[[ -z $_fcd_border ]] && _fcd_border="$(__fcd_get_border_style)"
	[[ -z $_fcd_path_anchor ]] && _fcd_path_anchor="$(__fcd_get_path_anchor "$_fcd_border" "$_fcd_layout" "$_fcd_height")"
	[[ -z $_fcd_path_column ]] && _fcd_path_column="$(__fcd_get_path_column "$_fcd_border" "$_fcd_path_anchor")"
	if [[ $_fcd_path_anchor == "header" ]]; then
		_fcd_path_padding="0"
		_fcd_path_truncate="auto"
		if [[ $_fcd_path_column -eq 1 || $_fcd_path_column -eq 2 ]]; then
			_fcd_path_column='3'
		elif [[ $_fcd_path_column -eq -1 ]]; then
			_fcd_path_column='-2'
		fi
	fi
	_fcd_layout="$(__fcd_get_layout "$_fcd_layout")"
}

if [[ -n ${FCD_DEFAULT_OPTS-} ]]; then
	# mapfile -d '' _fcd_args < <(__fcd_prepare_opts "$FCD_DEFAULT_OPTS")
	_fcd_args=()
	while IFS= read -r -d '' arg; do
		_fcd_args+=("$arg")
	done < <(__fcd_prepare_opts "$FCD_DEFAULT_OPTS")
	__fcd_parse_options '$FCD_DEFAULT_OPTS' "${_fcd_args[@]}"
	status=$?
	unset _fcd_args
	[[ $status -ne 0 ]] && exit $status
fi
if [[ -n ${FCD_DEFAULT_OPTS_FILE-} ]]; then
	_fcd_opts_file="$(command cat "$FCD_DEFAULT_OPTS_FILE" 2> /dev/null)"
	# mapfile -d '' _fcd_args < <(__fcd_prepare_opts "$_fcd_opts_file")
	_fcd_args=()
	while IFS= read -r -d '' arg; do
		_fcd_args+=("$arg")
	done < <(__fcd_prepare_opts "$_fcd_opts_file")
	__fcd_parse_options "${FCD_DEFAULT_OPTS_FILE}" "${_fcd_args[@]}"
	status=$?
	unset _fcd_args _fcd_opts_file
	[[ $status -ne 0 ]] && exit $status
fi
if [[ $# -gt 0 ]]; then
	__fcd_parse_options 'fcd' "$@"
	status=$?
	[[ $status -ne 0 ]] && exit $status
fi

__fcd_resolve_opts

if [[ ${XDG_SESSION_TYPE-} == "wayland" || -n ${WAYLAND_DISPLAY-} ]] && command -v wl-copy >/dev/null 2>&1; then
	_fcd_copy_command='wl-copy'
elif command -v xclip >/dev/null 2>&1; then
	_fcd_copy_command='xclip -selection clipboard -i'
elif command -v xsel >/dev/null 2>&1; then
	_fcd_copy_command='xsel --clipboard --input'
fi

__fcd_main
