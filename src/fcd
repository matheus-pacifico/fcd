#!/usr/bin/env bash

readonly _FCD_VERSION=0.1.0

_fcd_eol='\n'
_fcd_out_on_same=""
_fcd_navigation_mode="dir"
_fcd_show_hidden=0
_fcd_follow_symlink=1
_fcd_root_dir=""
_fcd_skip_dirs=".git,node_modules"
_fcd_max_depth="1"
_fcd_sort=1
_fcd_sort_order="asc"
_fcd_height=""
_fcd_min_height=""
_fcd_margin="0"
_fcd_padding="0"
_fcd_border=""
_fcd_path_anchor=""
_fcd_path_truncate="start"
_fcd_path_column=""
_fcd_path_padding="1"
_fcd_cycle=1
_fcd_highlight_line=0
_fcd_wrap="word"
_fcd_no_mouse=""
_fcd_layout="top"
_fcd_ellipsis=".."
_fcd_no_input=""
_fcd_info="default"
_fcd_separator=""
_fcd_p_window="nocycle:nohidden:40%:right"
_fcd_p_show_dirs=1
_fcd_p_show_files=0
_fcd_p_show_hidden=0
_fcd_p_follow_symlink=1
_fcd_p_sort=1
_fcd_p_sort_order="asc"
_fcd_p_mode="list"
_fcd_p_max_depth="1"
_fcd_use_tmux=0
_fcd_tmux_opts=()
_fcd_ignore_ctrl_z=""
_fcd_query=""
_fcd_define_separator=""
_fcd_copy_command=""

__fcd_get_skip_dirs_args() {
	local dirs="$1"
	local mode="$2"
	local escape_quotes="$3"
	local begin_prefix=''
	local prefix=''
	local sep=''
	local suffix=''
	local end_suffix=''
	local out=''

	if [[ $mode == "tree" ]]; then
		begin_prefix="-I '"
		sep='|'
		suffix='/'
		end_suffix="'"
	else
		begin_prefix='-type d \( '
		end_suffix=' \) -o'
		if [[ -n $mode ]]; then
			prefix="-name '"
			suffix="'"
		elif [[ -n $escape_quotes ]]; then
			prefix='-name \"'
			suffix='\"'
		else
			prefix='-name "'
			suffix='"'
		fi
	fi

	IFS=',' read -r -a new_dirs <<< "$dirs"
	for dir in "${new_dirs[@]}"; do
		[[ -z $dir ]] && continue
		if [[ -n $out ]]; then
			out+="${prefix:+ -o $prefix}${sep:-}$dir$suffix"
		else
			out+="$begin_prefix${prefix:-}$dir$suffix"
		fi
	done

	[[ -n $out ]] && builtin printf '%s' "$out$end_suffix" || builtin printf ''
}

__fcd_colorize() {
  local text="$1"
  local color="$2"
  local code

  case "$color" in
    red)    code='\x1b[31m' ;;
    green)  code='\x1b[32m' ;;
    yellow) code='\x1b[33m' ;;
    blue)   code='\x1b[34m' ;;
    bold)   code='\x1b[1m'  ;;
    *)      code='\x1b[m'   ;; # Default/Clear
  esac

  printf '%b%s%b' "$code" "$text" '\x1b[m'
}

__fcd_make_toast() {
	local message="$1"
	local duration="$2"
	local color="$3"
	local sleep_time # in seconds
	local toast

	toast="change-footer($(__fcd_colorize "$message" "$color"))+bg-cancel"
	case "$duration" in
		SHORT)   sleep_time=1 ;;
		MEDIUM)  sleep_time=2 ;;
		LONG)    sleep_time=4 ;;
		FOREVER) sleep_time=0 ;;
		*)       sleep_time=1 ;;
	esac
	[[ $sleep_time -ne 0 ]] && toast="$toast+bg-transform-footer(sleep $sleep_time)"

	printf '%s' "$toast"
}

__fcd_get_list_dir_logic () {
	local max_depth="$1"
	local sort="$2"
	local sort_order="$3"
	local follow_symlink="$4"
	local show_hidden="$5"
	local skip_dirs="$6"
	local dir="$7"
	local print_empty="$8"
	local cmd=''

	if [[ -n $print_empty ]]; then
		cmd='builtin printf ""'
	elif [[ -n $show_hidden ]]; then
		if [[ -n $dir ]]; then
			[[ $show_hidden -eq 1 ]] && show_hidden='-false -o' || show_hidden='-path "'"${dir%/}"'/.*" -o'
			cmd='builtin printf ".\n" && command find '"${follow_symlink:-}"' "'$dir'" -mindepth 1 '"${max_depth:+ -maxdepth $max_depth}"' \( '"$show_hidden"' '"$(__fcd_get_skip_dirs_args "$skip_dirs" "" "")"' -fstype "sysfs" -o -fstype "devfs" -o -fstype "devtmpfs" -o -fstype "proc" \) -prune -o -type d -printf "%P\n" '"${sort:+ | sort $sort $sort_order}"''
		else
			[[ $show_hidden -eq 1 ]] && show_hidden='-false -o' || show_hidden='-path \"${FZF_INPUT_LABEL%/}/.*\" -o'
			cmd='builtin printf \".\n\" && command find '"${follow_symlink:-}"' \"$FZF_INPUT_LABEL\" -mindepth 1 '"${max_depth:+ -maxdepth $max_depth}"' \( '"$show_hidden"' '"$(__fcd_get_skip_dirs_args "$skip_dirs" "" 1)"' -fstype \"sysfs\" -o -fstype \"devfs\" -o -fstype \"devtmpfs\" -o -fstype \"proc\" \) -prune -o -type d -printf \"%P\n\" 2>/dev/null '"${sort:+ | sort $sort $sort_order}"
		fi
	else
		skip_dirs="$(__fcd_get_skip_dirs_args "$skip_dirs" "list" 1)"
		cmd='if [[ ${FZF_HEADER_LABEL%%,*} -eq 1 ]]; then
			builtin printf \".\n\" && command find '"${follow_symlink:-}"' \"$FZF_INPUT_LABEL\" -mindepth 1 '"${max_depth:+ -maxdepth $max_depth}"' \( -false -o '"$skip_dirs"' -fstype \"sysfs\" -o -fstype \"devfs\" -o -fstype \"devtmpfs\" -o -fstype \"proc\" \) -prune -o -type d -printf \"%P\n\" 2>/dev/null '"${sort:+ | sort $sort $sort_order}"'
		else
			builtin printf \".\n\" && command find '"${follow_symlink:-}"' \"$FZF_INPUT_LABEL\" -mindepth 1 '"${max_depth:+ -maxdepth $max_depth}"' \( -path \"${FZF_INPUT_LABEL%/}/.*\" -o '"$skip_dirs"' -fstype \"sysfs\" -o -fstype \"devfs\" -o -fstype \"devtmpfs\" -o -fstype \"proc\" \) -prune -o -type d -printf \"%P\n\" 2>/dev/null '"${sort:+ | sort $sort $sort_order}"'
		fi'
	fi

	builtin printf '%s' "$cmd"
}

__fcd_get_path_location_build_logic() {
	local padding="$1"
	local truncate="$2"
	local ellipsis="$3"
	local path_anchor="$4"
	local path_column="$5"
	local cmd

	cmd='padding=$(printf "%*s" '"$padding"' "")
	max=$((FZF_COLUMNS))
	label_length=$((${#PREFIX} + ${#SEP} + ${#_PATH}))
	path_location="${padding:-}${PREFIX:-}${SEP:-}$_PATH${padding:-}"
	if (( label_length -le 0 )); then
		path_location=""
	elif (( label_length + '"$((padding * 2))"' > max )); then
		cut=$((max - '"${#ellipsis}"' - '"$((padding * 2))"'))
		(( cut < 1 )) && cut=1
		if [[ "'"$truncate"'" == "start" ]]; then
			path_location="${padding:-}${PREFIX:-}${SEP:-}'"${ellipsis:-}"'${_PATH: -cut}${padding:-}"
		elif [[ "'"$truncate"'" == "end" ]]; then
			path_location="${padding:-}${PREFIX:-}${SEP:-}${_PATH:0:cut}'"${ellipsis:-}"'${padding:-}"
		fi
	fi'
	if [[ $path_anchor == "header" ]]; then
	  if (( path_column == 0 )); then
      cmd="$cmd"'
			spaces=$(((max - ${#path_location}) / 2 - 2))
			(( spaces < 0 )) && spaces=0
			path_location=$(printf "%${spaces}s%s" "" "$path_location")'
    elif (( path_column > 3 )); then
      cmd="$cmd"'
			spaces=$(('"$path_column"' - 3))
			path_location=$(printf "%${spaces}s%s" "" "$path_location")'
    elif (( path_column < 0 )); then
      cmd="$cmd"'
			offset=$((-'"$path_column"'))
			spaces=$((max - ${#path_location} - offset - 1))
			(( spaces < 0 )) && spaces=0
			path_location=$(printf "%${spaces}s%s" "" "$path_location")'
    fi
	fi

	builtin printf '%s' "$cmd"
}

__fcd_get_path_location_action() {
	local path_anchor="$1"
	local return_noop="$2"
	local plus="$3"
	local cmd=''

	if [[ $path_anchor =~ ^(top|bottom)$ ]]; then
		cmd="${plus:++}"'change-border-label($path_location)'
	elif [[ $path_anchor == "header" ]]; then
		cmd="${plus:++}"'change-header($path_location)'
	elif [[ -n $return_noop ]]; then
		cmd='noop'
	fi

	builtin printf '%s' "$cmd"
}

__fcd_get_go_to_logic() {
	local max_depth="$1"
	local sort="$2"
	local sort_order="$3"
	local follow_symlink="$4"
	local skip_dirs="$5"
	local path_padding="$6"
	local path_truncate="$7"
	local ellipsis="$8"
	local path_anchor="$9"
	local path_column="${10}"
	local cmd

	cmd='if [[ $_PATH == $FZF_INPUT_LABEL ]]; then
		printf "noop"
	else
		FZF_INPUT_LABEL="$_PATH"
		'"$(__fcd_get_path_location_build_logic "$path_padding" "$path_truncate" "$ellipsis" "$_fcd_path_anchor" "$_fcd_path_column")"'
		printf "%s" "change-input-label($_PATH)+change-border-label($path_location)+clear-query+rebind(load)+change-list-label(1)+pos(1)+reload('"$(__fcd_get_list_dir_logic "$max_depth" "$sort" "$sort_order" "$follow_symlink" "" "$skip_dirs")"')"
	fi'

	builtin printf '%s' "$cmd"
}

__fcd_get_preview_label_logic() {
	local cmd='selected={}
	if [[ -n $selected && $selected != "." ]]; then
		selected="${selected%%$'"'\t'"'*}"
		max="$FZF_PREVIEW_COLUMNS"
		label_length="${#selected}"
		if (( label_length -le 0 )); then
			printf ""
		elif (( label_length + 2 <= max )); then 
			printf " %s " "$selected"
		else
			printf "%s" "$selected"
		fi
	fi'

	builtin printf '%s' "$cmd"
}

__fcd_rebuild_path() {
	local cmd='base_path="${FZF_INPUT_LABEL%%$'"'\t'"'*}"
		_path="${FZF_INPUT_LABEL##*$'"'\t'"'}"
		FZF_INPUT_LABEL="${base_path%/}/${_path#/}"'

	builtin printf '%s' "$cmd"
}

__fcd_get_layout() {
	local layout="$1"

	case "$layout" in
		bottom)   builtin printf 'default' ;;
		top-list) builtin printf 'reverse-list' ;;
		top|*)    builtin printf 'reverse' ;;
	esac
}

__fcd_get_path_anchor() {
	local border_style="$1"
	local layout="$2"
	local height="$3"
	
	if [[ $border_style =~ ^(none|right|left|vertical)$ ]]; then
		builtin printf 'header'
	elif [[ $border_style == "line" && -z $height ]]; then
		builtin printf 'header'
	elif [[ $border_style == "bottom" ]]; then
		[[ $layout == "top" ]] && builtin printf 'header' || builtin printf 'bottom'
	else
		builtin printf 'top'
	fi
}

__fcd_get_path_column() {
	local border_style="$1"
	local path_anchor="$2"
	
	if [[ $path_anchor == "header" ]]; then
		builtin printf '3'
	elif [[ $border_style =~ ^(top|bottom|horizontal|line)$ ]]; then
		builtin printf '2'
	else
		builtin printf '4'
	fi
}

__fcd_get_preview_command() {
	local mode="$1"
	local show_dirs="$2"
	local show_files="$3"
	local max_depth="$4"
	local sort="$5"
	local sort_order="$6"
	local show_hidden="$7"
	local follow_symlink="$8"
	local skip_dirs="$9"
	local cmd args

	[[ $follow_symlink -eq 0 ]] && follow_symlink=""
	skip_dirs="$(__fcd_get_skip_dirs_args "$skip_dirs" "$mode" "")"
	if [[ $mode == "tree" ]]; then
		cmd='command tree -C '"${follow_symlink:+-l}"' --noreport "$full_path"'
		[[ $sort -eq 1 ]] && sort="${sort_order:-}" || sort="-U"
		[[ $show_hidden -eq 0 ]] && show_hidden="" || show_hidden="-a"
		args="$show_hidden $sort"
		if [[ $show_dirs -eq 0 ]]; then
			args+=" --prune"
		elif [[ $show_files -eq 0 ]]; then
			args+=" -d"
		fi
		args+=" $skip_dirs"
		if [[ $max_depth -eq 1 ]]; then
      args+=" -L 1 -i -F"
			[[ $show_dirs -eq 0 ]] && args+=" | sed '1d; /\/$/d'"  || args+=" | sed '1d'"
		else
      args+=" ${max_depth:+ -L $max_depth} | sed '1d; s/^.\{4\}//'"
		fi
	else
		cmd='command find '"${follow_symlink:+-L}"' "$full_path"'
		[[ $sort -eq 1 ]] && sort="-h" || sort=""
		[[ $show_hidden -eq 0 ]] && show_hidden="-path \"\${full_path%/}/.*\"" || show_hidden="-false"
    if [[ $show_dirs -eq 0 ]]; then
			args="-o -type f -printf '%P\n'"
		else
			[[ $show_files -eq 0 ]] && args="-o -type d -printf '%P\n'" || args="-o -type d -printf '%P/\n' -o -type f -printf '%P\n'"
		fi
		args="-mindepth 1 ${max_depth:+ -maxdepth $max_depth} \\( $show_hidden -o $skip_dirs -fstype 'sysfs' -o -fstype 'devfs' -o -fstype 'devtmpfs' -o -fstype 'proc' \\) -prune ${args} 2>/dev/null ${sort:+ | sort $sort $sort_order}"
		[[ $mode == "grid" ]] &&	args="$args | paste -d $'\v' - - | sed 's/\v/ | /g; s/ | $//'"
	fi

	builtin printf '%s %s' "$cmd" "$args"
}

__fcd_get_preview_logic() {
	local mode="$1"
	local show_dirs="$2"
	local show_files="$3"
	local max_depth="$4"
	local sort="$5"
	local sort_order="$6"
	local follow_symlink="$7"
	local skip_dirs="$8"
	local cmd
	
	cmd='if [[ $SELECTED == "." ]]; then
    text="── Current directory ──"
    padding=$(( (FZF_PREVIEW_COLUMNS - ${#text}) / 2 ))
    (( padding < 0 )) && padding=0
    printf "%${padding}s%s" "" "$text"
	elif [[ -n $SELECTED ]]; then
		full_path="${FZF_INPUT_LABEL%/}/${SELECTED#/}"
		if [[ ${FZF_HEADER_LABEL##*,} -eq 1 ]]; then
			'"$(__fcd_get_preview_command "$mode" "$show_dirs" "$show_files" "$max_depth" "$sort" "$sort_order" 1 "$follow_symlink" "$skip_dirs")"'
		else
			'"$(__fcd_get_preview_command "$mode" "$show_dirs" "$show_files" "$max_depth" "$sort" "$sort_order" 0 "$follow_symlink" "$skip_dirs")"'
		fi
	fi'

	builtin printf '%s' "$cmd"
}

__fcd_get_enter_action() {
	local cmd='selected={}
	if [[ $selected == "." ]]; then
		final_path="$FZF_INPUT_LABEL"
	else
		selected="${selected##*$'"'\t'"'}"
		final_path="${FZF_INPUT_LABEL%/}/${selected#/}"
	fi
	printf "enter\n%s\n0\n2,2" "$final_path"'

	builtin printf '%s' "$cmd"
}

__fcd_get_copy_path_logic() {
	local copy_command="$1"
	local copy_selected="$2"
	local resolved_path=''
	local cmd=''
	local success="green"
	local alert="yellow"
	local failure="red"

	if [[ -z $copy_command ]]; then
		cmd='printf "%s" "'"$(__fcd_make_toast "No clipboard utility found!" MEDIUM "$alert")"'"'
	else
		if [[ -n $copy_selected ]]; then
			resolved_path='selected={}
			selected="${selected##*$'"'\t'"'}"
			[[ -n $selected && $selected != "." ]] && FZF_INPUT_LABEL="${FZF_INPUT_LABEL%/}/${selected#/}"'
		fi
		cmd="$resolved_path"'
		if [[ -z $FZF_INPUT_LABEL ]]; then
			printf "%s" "'"$(__fcd_make_toast "No path to copy!" MEDIUM "$alert")"'"
		elif printf "%s" "$FZF_INPUT_LABEL" | '"$copy_command"' 2>/dev/null; then
			printf "%s" "'"$(__fcd_make_toast "Path copied to clipboard!" SHORT "$success")"'"
		else
			printf "%s" "'"$(__fcd_make_toast "Failed to copy path!" MEDIUM "$failure")"'"
		fi'
	fi

	builtin printf '%s' "$cmd"
}

__fcd_get_nav_pos_logic() {
	local cmd='[[ -z $FZF_LIST_LABEL ]] && last_position="1" || last_position="${FZF_LIST_LABEL##*,}"
	printf "pos(%s)" "$last_position"'

	builtin printf '%s' "$cmd"
}

__fcd_get_nav_prev_logic() {
	local cmd='[[ $FZF_LIST_LABEL == *","* ]] && FZF_LIST_LABEL="${FZF_LIST_LABEL%,*}" || FZF_LIST_LABEL=""'

	builtin printf '%s' "$cmd"
}

__fcd_get_nav_next_logic() {
	local max_depth="$1"
	local cmd='current_position=$(({n} + 1))'

	if [[ $max_depth -eq 1 ]]; then
		cmd="$cmd"'
		[[ $FZF_LIST_LABEL == *","* ]] && FZF_LIST_LABEL="${FZF_LIST_LABEL%,*},$current_position,1" || FZF_LIST_LABEL="$current_position,1"'
	else
		cmd="$cmd"'
		if [[ -z $FZF_INPUT_LABEL ]]; then
			[[ $FZF_LIST_LABEL == *","* ]] && FZF_LIST_LABEL="${FZF_LIST_LABEL%,*},$current_position,1" || FZF_LIST_LABEL="$current_position,1"
		else
			bars_only="${SELECTED//[^\/]/}"
			positions="${bars_only//\//,1}"
			[[ $FZF_LIST_LABEL == *","* ]] && FZF_LIST_LABEL="${FZF_LIST_LABEL%,*},$current_position${positions:-},1" || FZF_LIST_LABEL="${current_position}${positions:-},1"
		fi'
	fi

	builtin printf '%s' "$cmd"
}

__fcd_get_dir_alt_q_action() {
	local max_depth="$1"
	local cmd='printf "alt-q\n$FZF_INPUT_LABEL\n${FZF_LIST_LABEL:-1}\n$FZF_HEADER_LABEL"'

	if [[ $max_depth -eq 1 ]]; then
		cmd='current_position={n}
		current_position="${current_position:-0}"
		current_position=$((current_position + 1))
		[[ $FZF_LIST_LABEL == *","* ]] && FZF_LIST_LABEL="${FZF_LIST_LABEL%,*},$current_position" || FZF_LIST_LABEL="$current_position"
		'"$cmd"
	fi

	builtin printf '%s' "$cmd"
}

__fcd_get_drive_alt_q_action() {
	local navigation_mode="$1"
	local cmd='ignore'

	if [[ $navigation_mode == "toggled_drive" ]]; then
		cmd='become:printf "alt-q\nempty\n1\n$FZF_HEADER_LABEL"'
	fi
	
	builtin printf '%s' "$cmd"
}

__fcd_get_info_command() {
	local cmd='if [[ -n $FZF_INPUT_LABEL ]] && (( FZF_TOTAL_COUNT != 0 )); then
		((FZF_TOTAL_COUNT--))
		[[ $FZF_QUERY =~ ^[[:space:].]*$ && ! $FZF_QUERY =~ \.\. ]] && ((FZF_MATCH_COUNT--))
	fi
	printf "%s" "$FZF_MATCH_COUNT/$FZF_TOTAL_COUNT"'
	
	builtin printf '%s' "$cmd"
}

__fcd_fzfcmd() {
	(( _fcd_use_tmux )) && builtin printf 'command fzf-tmux' || builtin printf 'command fzf'
}

__fcd_launch_dir_fzf() {
	local toggle_history="$1"
	local dir="$2"
	local nav_history="$3"

	local pos_one=""
	local p_show_hidden='$P_SHOW_HIDDEN'
	local p_view_hidden
	local sync_status=0
	local not_a_dir
	local path_border_pos

	[[ $_fcd_path_anchor =~ ^(top|bottom)$ ]] && path_border_pos="$_fcd_path_anchor"
	[[ $_fcd_max_depth -ne 1 ]] && pos_one="pos(1)"
	if [[ $_fcd_p_show_hidden == "auto" ]]; then
		p_show_hidden=""
		sync_status=1
		p_view_hidden="$_fcd_show_hidden"
	else
		p_view_hidden="$_fcd_p_show_hidden"
	fi
	[[ -z $toggle_history ]] && toggle_history="${_fcd_show_hidden},${p_view_hidden}"

	if [[ -n $_fcd_root_dir ]]; then
		if ! dir=$(builtin cd -- "$_fcd_root_dir" 2>/dev/null && builtin pwd); then
			not_a_dir=1
			dir="$_fcd_root_dir"
		fi
		_fcd_root_dir=""
	fi

	$(__fcd_fzfcmd) ${_fcd_tmux_opts[@]:+ "${_fcd_tmux_opts[@]}" -- } \
		${_fcd_min_height:+ --min-height "$_fcd_min_height"} ${_fcd_height:+ --height "$_fcd_height"} --layout="$_fcd_layout" --scheme="path" \
		--input-label="$dir" --input-border="none" --list-label="$nav_history" \
		--border="$_fcd_border" --border-label-pos="$_fcd_path_column${path_border_pos:+:$path_border_pos}" --list-border="none" \
		--pointer="▌" --scrollbar="▐┃" --no-multi ${_fcd_cycle:+ --cycle} ${_fcd_highlight_line:+ --highlight-line} \
		--header-border="none" --header-label="$toggle_history" --header-first \
		--footer-border="none" ${_fcd_no_input:+ --no-input} \
		--margin="$_fcd_margin" --padding="$_fcd_padding" --query="$_fcd_query" ${_fcd_no_mouse:+ --no-mouse} --tabstop="1" ${_fcd_wrap:+ --wrap "$_fcd_wrap"} \
		--ellipsis="$_fcd_ellipsis" --info="$_fcd_info" ${_fcd_define_separator:+ --separator "$_fcd_separator"} \
		--color="label:blue,preview-label:bright-blue,border:bright-black,header:blue" \
		--preview-window="$_fcd_p_window" \
		--preview='SELECTED={}
				'"$(__fcd_get_preview_logic "$_fcd_p_mode" "$_fcd_p_show_dirs" "$_fcd_p_show_files" "$_fcd_p_max_depth" "$_fcd_p_sort" "$_fcd_p_sort_order" "$_fcd_p_follow_symlink" "$_fcd_skip_dirs")" \
		--info-command="$(__fcd_get_info_command)" ${_fcd_ignore_ctrl_z:+ --bind 'ctrl-z:ignore'} \
		--bind 'start:reload:'"$(__fcd_get_list_dir_logic "$_fcd_max_depth" "$_fcd_sort" "$_fcd_sort_order" "$_fcd_follow_symlink" "$_fcd_show_hidden" "$_fcd_skip_dirs" "$dir" "$not_a_dir")" \
		--bind 'start:+transform:_PATH="$FZF_INPUT_LABEL"
				'"$(__fcd_get_path_location_build_logic "$_fcd_path_padding" "$_fcd_path_truncate" "$_fcd_ellipsis" "$_fcd_path_anchor" "$_fcd_path_column")"'
				printf "%s" "'"$(__fcd_get_path_location_action "$_fcd_path_anchor" 1 "")"'"' ${not_a_dir:+ --bind 'start:+transform: printf "%s" "'"$(__fcd_make_toast "Directory not found!" LONG "red")"'"'} \
		--bind 'resize:transform-preview-label('"$(__fcd_get_preview_label_logic)"')+transform:_PATH="$FZF_INPUT_LABEL"
				'"$(__fcd_get_path_location_build_logic "$_fcd_path_padding" "$_fcd_path_truncate" "$_fcd_ellipsis" "$_fcd_path_anchor" "$_fcd_path_column")"'
